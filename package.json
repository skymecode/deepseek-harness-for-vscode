{
  "name": "deepseek-harness-for-vscode",
  "displayName": "DeepSeek Harness for Visual Studio Code",
  "description": "%extension.description%",
  "version": "0.5.6",
  "type": "module",
  "publisher": "skymecode",
  "license": "MIT",
  "icon": "media/deepseek-harness.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/skymecode/deepseek-harness-for-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "agent",
    "coding assistant",
    "deepseek harness"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "scripts": {
    "patch:dsh-pi-ai": "node scripts/patch-dsh-llm-pi-ai.mjs",
    "postinstall": "npm run patch:dsh-pi-ai",
    "check-types": "npm run patch:dsh-pi-ai && tsc --noEmit",
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "pretest": "npm run patch:dsh-pi-ai",
    "test": "vitest run",
    "pretest:watch": "npm run patch:dsh-pi-ai",
    "test:watch": "vitest",
    "package": "npm run check-types && npm run test && node esbuild.mjs --production && node scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run check-types && node esbuild.mjs --production"
  },
  "contributes": {
    "commands": [
      {
        "command": "deepseekHarness.openChat",
        "title": "%command.openChat%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deepseekHarness.openChatWindow",
        "title": "%command.openChatWindow%",
        "icon": "$(new-window)"
      },
      {
        "command": "deepseekHarness.reloadRuntime",
        "title": "%command.reloadRuntime%",
        "icon": "$(refresh)"
      },
      {
        "command": "deepseekHarness.setApiKey",
        "title": "%command.setApiKey%"
      },
      {
        "command": "deepseekHarness.clearApiKey",
        "title": "%command.clearApiKey%"
      },
      {
        "command": "deepseekHarness.showLogs",
        "title": "%command.showLogs%"
      },
      {
        "command": "deepseekHarness.importSession",
        "title": "%command.importSession%",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek Harness for Visual Studio Code",
          "icon": "media/deepseek-harness.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "id": "deepseekHarness.chatView",
          "name": "%view.chat%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "deepseekHarness.openChatWindow",
          "when": "view == deepseekHarness.chatView",
          "group": "navigation@3"
        },
        {
          "command": "deepseekHarness.reloadRuntime",
          "when": "view == deepseekHarness.chatView",
          "group": "navigation@1"
        },
        {
          "command": "deepseekHarness.showLogs",
          "when": "view == deepseekHarness.chatView",
          "group": "navigation@2"
        },
        {
          "command": "deepseekHarness.importSession",
          "when": "view == deepseekHarness.chatView",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deepseekHarness.openChat",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "!inChat"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness for Visual Studio Code",
      "properties": {
        "deepseekHarness.model": {
          "type": "string",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "enumDescriptions": [
            "%config.model.flash%",
            "%config.model.pro%"
          ],
          "default": "deepseek-v4-flash",
          "description": "%config.model%"
        },
        "deepseekHarness.reasoningEffort": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "high",
            "max"
          ],
          "enumDescriptions": [
            "%config.reasoning.off%",
            "%config.reasoning.low%",
            "%config.reasoning.high%",
            "%config.reasoning.max%"
          ],
          "default": "high",
          "description": "%config.reasoning%"
        },
        "deepseekHarness.agentPreset": {
          "type": "string",
          "enum": [
            "standard",
            "code",
            "minimal",
            "cordis"
          ],
          "enumDescriptions": [
            "%config.preset.standard%",
            "%config.preset.code%",
            "%config.preset.minimal%",
            "%config.preset.cordis%"
          ],
          "default": "standard",
          "description": "%config.preset%"
        },
        "deepseekHarness.provider": {
          "type": "string",
          "default": "deepseek-official",
          "description": "%config.provider%"
        },
        "deepseekHarness.permissionMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "enumDescriptions": [
            "%config.permission.readOnly%",
            "%config.permission.workspaceWrite%",
            "%config.permission.dangerFullAccess%"
          ],
          "default": "workspace-write",
          "description": "%config.permission%"
        },
        "deepseekHarness.autoAttachSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoAttachSelection%"
        },
        "deepseekHarness.webSearch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.webSearch%"
        },
        "deepseekHarness.experimentalAutoEffort": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.experimentalAutoEffort%"
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.101.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "dompurify": "3.4.13",
    "markdown-it": "15.0.0",
    "node": "22.22.3",
    "pnpm": "11.21.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "node@22.22.3": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.1-rc.2": true,
    "esbuild@0.25.12": true,
    "node-pty@1.2.0-beta.15": true,
    "koffi@3.1.5": true,
    "keytar@7.9.0": true,
    "protobufjs@7.6.5": true,
    "@vscode/vsce-sign@2.0.9": true,
    "@google/genai@1.52.0": true
  }
}
