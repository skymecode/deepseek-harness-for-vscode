.github/**
.agents/**
.vscode/**
.commandcode/**
# Per-session git worktree isolation data (A2). Created under the repo root at
# runtime by WorktreeService; must never ship in the VSIX.
.dsh-worktrees/**
src/**
test/**
coverage/**
docs/images/**
dist/**/*.map
.gitignore
eslint.config.mjs
esbuild.mjs
tsconfig.json
vitest.config.ts
package-lock.json
*.zip
media/chat.js
node_modules/node/node_modules/node-bin-setup/**
node_modules/node/node_modules/node-bin-*/bin/**
node_modules/node/node_modules/node-bin-*/include/**
node_modules/node/node_modules/node-bin-*/share/**
node_modules/node/node_modules/node-bin-*/CHANGELOG.md
node_modules/node/node_modules/node-bin-*/README.md
node_modules/node/node_modules/node-bin-*/package.json
# The nested platform package (node-win-x64 / node-darwin-* / …) duplicates the
# binary already present at node_modules/node/bin/node(.exe) used by the
# runtime resolver. Excluding it halves the packaged Node footprint on every
# platform; the resolver never touches these nested copies.
node_modules/node/node_modules/node-*/**

node_modules/node/installArchSpecificPackage.js
node_modules/node/README.md
node_modules/node/node_modules/.package-lock.json
# Debug symbol files are never loaded at runtime; node-pty ships per-platform
# .pdb files (several MB each) that only bloat the VSIX.
**/*.pdb
node_modules/**/*.d.ts
node_modules/**/*.d.mts
node_modules/**/*.d.cts
node_modules/**/*.map
node_modules/**/README*
node_modules/**/readme*
node_modules/**/CHANGELOG*
node_modules/**/test/**
node_modules/**/tests/**
# The native workbench disables DSH's official Web Office preview service.
# These platform engines are otherwise pulled into the Web profile solely for
# Office-to-PDF conversion and account for roughly 259 MB on macOS arm64.
node_modules/@deepseek-ai/libreoffice-kit-darwin-arm64/**
node_modules/@deepseek-ai/libreoffice-kit-darwin-x64/**
node_modules/@deepseek-ai/libreoffice-kit-linux-x64/**
node_modules/@deepseek-ai/libreoffice-kit-linux-arm64/**
node_modules/@deepseek-ai/libreoffice-kit-win32-x64/**
node_modules/@deepseek-ai/libreoffice-kit-win32-arm64/**
# The document-preview client is part of the disabled official Web UI row.
node_modules/@deepseek-ai/dsh-client-ui-sidebar-documentpreview/**
node_modules/@deepseek-ai/dsh-office-to-pdf/**
# Experimental voice input is not mounted by the native workbench profile.
node_modules/sherpa-onnx-*/**
node_modules/@deepseek-ai/dsh-experimental-voice-input-bundle/**
node_modules/@deepseek-ai/dsh-experimental-speech-to-text/**
node_modules/@deepseek-ai/dsh-experimental-speech-to-text-sensevoice/**
node_modules/@deepseek-ai/dsh-experimental-api-speech-to-text/**
node_modules/@deepseek-ai/dsh-experimental-client-ui-voice-input/**
